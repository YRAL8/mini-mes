# Copy to .env and adjust if needed. No secrets belong in this file.

# MQTT broker
MQTT_HOST=mosquitto
MQTT_PORT=1883
MACHINE_ID=line1

# PostgreSQL
# Local development falls back to "mes" if unset. A server deployment
# (docker-compose.prod.yml) refuses to start without a real value here.
POSTGRES_PASSWORD=mes
DATABASE_URL=postgresql+psycopg2://mes:mes@db:5432/mes

# MES / line parameters
IDEAL_CYCLE_MS=333

# ERP / warehouse
RAW_START=4000
FINISHED_CAPACITY=3000
RAW_REORDER_LEVEL=600
RAW_REORDER_QTY=2500
RAW_LOW_WARN_LEVEL=1200
FINISHED_SHIPMENT_QTY=1500

# --- Server deployment only (docker-compose.prod.yml) ---
# Domain Caddy requests an HTTPS certificate for. A bare IP cannot get one, so
# see https://sslip.io for the free "<ip-with-dashes>.sslip.io" trick, or use
# a real domain if you have one.
CADDY_DOMAIN=change-me.sslip.io

# Visitor tracker (watcher/): reports new IPs hitting the site to Telegram.
# Create a bot via @BotFather to get TELEGRAM_BOT_TOKEN; TELEGRAM_CHAT_ID is
# your own chat with that bot (send it any message, then read the chat id
# from https://api.telegram.org/bot<token>/getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WATCHER_EXCLUDE_IPS=
